+
+  it('keeps cluster-mode successful starts on their existing online/exit path', async function() {
+    var env = makeEnv({ exec_mode: 'cluster_mode' });
+    var originalNodeApp = God.nodeApp;
+    var clusterProcess;
+    var callbackCount = 0;
+    var events = [];
+    var eventListener = function(event) {
+      if (event.process && event.process.name === env.name)
+        events.push(event.event);
+    };
+    God.bus.on('process:event', eventListener);
+
+    God.nodeApp = function(pm2Env, callback) {
+      clusterProcess = new EventEmitter();
+      clusterProcess.pm2_env = pm2Env;
+      clusterProcess.process = { pid: process.pid };
+      callback(null, clusterProcess);
+      setImmediate(function() {
+        clusterProcess.emit('online');
+        clusterProcess.emit('online');
+        clusterProcess.emit('exit', 0, null);
+      });
+    };
+
+    try {
+      var response = await new Promise(function(resolve, reject) {
+        var timer = originalSetTimeout(function() {
+          reject(new Error('cluster executeApp callback did not complete'));
+        }, 1000);
