+    } finally {
+      run.restore();
+    }
+  });
+
+  [false, true].forEach(function(waitReady) {
+    it('concludes a quick exit once (wait_ready=' + waitReady + ')', async function() {
+      writeFixture('process.exit(0);');
+      var run = startApp(makeEnv({ wait_ready: waitReady, listen_timeout: 1500 }));
