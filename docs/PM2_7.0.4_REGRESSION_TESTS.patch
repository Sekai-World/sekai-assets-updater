+/**
+ * Regression coverage for asynchronous child_process.spawn() failures in
+ * fork mode. This suite uses an isolated PM2_HOME and never starts a daemon.
+ */
+
+var assert = require('assert');
+var childProcess = require('child_process');
+var EventEmitter = require('events');
+var fs = require('fs');
+var os = require('os');
+var path = require('path');
+
+var testHome = fs.mkdtempSync(path.join(os.tmpdir(), 'pm2-async-spawn-'));
+process.env.PM2_HOME = testHome;
+process.env.OVER_HOME = testHome;
+process.env.PM2_MODULE_CONF_FILE = path.join(testHome, 'module_conf.json');
+process.env.NODE_ENV = 'test';
+fs.mkdirSync(path.join(testHome, 'logs'));
+fs.mkdirSync(path.join(testHome, 'pids'));
+fs.writeFileSync(path.join(testHome, 'module_conf.json'), '{}');
+
+// God.init() schedules its daemon worker after 500ms. This test exercises the
+// in-process God state machine only, so suppress that one startup timer while
+// loading God and leave every other timer untouched.
+var originalSetTimeout = global.setTimeout;
+global.setTimeout = function(callback) {
+  if (callback && callback.toString().indexOf('God.Worker.start') !== -1)
+    return { unref: function() {} };
+  return originalSetTimeout.apply(this, arguments);
+};
+
+var God = require('../../lib/God');
+var Utility = require('../../lib/Utility');
+var cst = require('../../constants');
+global.setTimeout = originalSetTimeout;
+
+// Worker.start() is deliberately not run in this isolated test process.
+God.registerCron = function() {};
+
+var activeRuns = [];
+var fixturePath = path.join(testHome, 'fork-app.js');
+var nameCounter = 0;
+
+function writeFixture(contents) {
+  fs.writeFileSync(fixturePath, contents);
+  return fixturePath;
+}
+
+function makeEnv(overrides) {
+  var name = 'async-spawn-' + (++nameCounter);
+  return Object.assign({
+    name: name,
+    cwd: testHome,
+    pm_cwd: testHome,
+    pm_exec_path: fixturePath,
+    exec_interpreter: process.execPath,
+    exec_mode: 'fork_mode',
+    node_args: [],
+    args: [],
+    env: {},
+    pm_pid_path: path.join(testHome, 'pids', name + '.pid'),
+    pm_out_log_path: path.join(testHome, 'logs', name + '-out.log'),
+    pm_err_log_path: path.join(testHome, 'logs', name + '-err.log'),
+    autostart: true,
+    autorestart: false,
+    wait_ready: false,
+    listen_timeout: 1000,
+    min_uptime: 1000,
+    max_restarts: 16,
+    unstable_restarts: 0
+  }, overrides || {});
+}
+
+function startApp(env, withCallback) {
+  var state = {
+    child: null,
+    callbackCount: 0,
+    spawnErrorCount: 0,
+    exitCount: 0,
+    closeCount: 0,
+    killCount: 0,
+    logStreams: [],
+    events: [],
+    closePromise: null
+  };
+  state.closePromise = new Promise(function(resolve) { state.resolveClose = resolve; });
+
+  var originalSpawn = childProcess.spawn;
+  var originalStartLogging = Utility.startLogging;
+  var eventListener = function(event) {
+    if (event.process && event.process.name === env.name)
+      state.events.push(event.event);
+  };
+
+  childProcess.spawn = function() {
+    var child = originalSpawn.apply(this, arguments);
+    state.child = child;
+    var originalKill = child.kill;
+    child.kill = function() {
+      state.killCount++;
+      return originalKill.apply(this, arguments);
+    };
+    child.on('error', function() { state.spawnErrorCount++; });
+    child.on('exit', function() { state.exitCount++; });
+    child.once('close', function(code, signal) {
+      state.closeCount++;
+      state.resolveClose({ code: code, signal: signal });
+    });
+    return child;
+  };
+
+  Utility.startLogging = function(stds, callback) {
+    return originalStartLogging.call(this, stds, function(err) {
+      state.logStreams = Object.keys(stds).map(function(key) {
+        return stds[key];
+      }).filter(function(stream) {
+        return stream && typeof stream.destroy === 'function';
+      });
+      return callback(err);
+    });
+  };
+
+  God.bus.on('process:event', eventListener);
+
+  var callbackTimer;
+  var result = new Promise(function(resolve, reject) {
+    if (withCallback !== false) {
+      callbackTimer = originalSetTimeout(function() {
+        reject(new Error('executeApp callback did not complete'));
+      }, 2000);
+    }
+
+    try {
+      if (withCallback === false) {
+        God.executeApp(env);
+        resolve(null);
+      }
+      else {
+        God.executeApp(env, function(err, proc) {
+          state.callbackCount++;
+          if (state.callbackCount === 1) {
+            clearTimeout(callbackTimer);
+            resolve({ err: err, proc: proc });
+          }
+        });
+      }
+    } catch (err) {
+      clearTimeout(callbackTimer);
+      reject(err);
+    }
+  });
+
+  var run = {
+    state: state,
+    result: result,
+    restore: function() {
+      childProcess.spawn = originalSpawn;
+      Utility.startLogging = originalStartLogging;
+      God.bus.removeListener('process:event', eventListener);
+      clearTimeout(callbackTimer);
+    }
+  };
+  activeRuns.push(run);
+  return run;
+}
+
+function nextTurn() {
+  return new Promise(function(resolve) { setImmediate(resolve); });
+}
+
+function assertLogsClosed(state) {
+  state.logStreams.forEach(function(stream) {
+    assert.strictEqual(stream.destroyed, true, 'fork log stream should be destroyed');
+  });
+}
+
+function waitForClose(state) {
+  return new Promise(function(resolve) {
+    var timer = originalSetTimeout(resolve, 1000);
+    state.closePromise.then(function(result) {
+      clearTimeout(timer);
+      resolve(result);
+    });
+  });
+}
+
+function spawnControlledChild(pm2Env) {
+  return new Promise(function(resolve, reject) {
+    var child = childProcess.spawn(process.execPath, [
+      '-e', 'setInterval(function() {}, 1000);'
+    ], { stdio: 'ignore' });
+    child.pm2_env = pm2Env;
+    child.process = { pid: child.pid };
+    child.killCount = 0;
+    child.testClose = new Promise(function(resolve) {
+      child.once('close', function(result) {
+        child.testClosed = true;
+        resolve(result);
+      });
+    });
+    var originalKill = child.kill.bind(child);
+    child.kill = function(signal) {
+      child.killCount++;
+      return originalKill(signal);
+    };
+    child.once('error', reject);
+    child.once('spawn', function() {
+      resolve(child);
+    });
+  });
+}
+
+function trackChildClose(child) {
+  if (!child) return Promise.resolve();
+  if (child.testClose) return child.testClose;
+  if (child.testClosed) return Promise.resolve();
+
+  child.testClose = new Promise(function(resolve) {
+    child.once('close', function(result) {
+      child.testClosed = true;
+      resolve(result);
+    });
+  });
+  return child.testClose;
+}
+
+function waitForChildClose(child) {
+  return trackChildClose(child);
+}
+
+function killTestChild(child) {
+  if (!child) return Promise.resolve();
+  if (child.exitCode !== null || child.signalCode !== null)
+    return waitForChildClose(child);
+  try { child.kill('SIGKILL'); } catch (e) {}
+  return waitForChildClose(child);
+}
+
+describe('fork mode asynchronous spawn failures', function() {
+  this.timeout(5000);
+
+  afterEach(async function() {
+    for (var i = activeRuns.length - 1; i >= 0; i--) {
+      var run = activeRuns[i];
+      var state = run.state;
+      run.restore();
+      if (state.child && state.child.exitCode === null && state.child.signalCode === null) {
+        try { state.child.kill('SIGKILL'); } catch (e) {}
+      }
+      if (state.closePromise) {
+        await waitForClose(state);
+      }
+      if (state.child && state.child.pm2_env)
+        delete God.clusters_db[state.child.pm2_env.pm_id];
+      activeRuns.splice(i, 1);
+    }
+  });
+
+  after(function() {
+    fs.rmSync(testHome, { recursive: true, force: true });
+  });
+
+  [false, true].forEach(function(waitReady) {
+    it('reports invalid interpreter spawn failure once (wait_ready=' + waitReady + ')', async function() {
+      writeFixture('setInterval(function() {}, 1000);');
+      var env = makeEnv({
+        exec_interpreter: path.join(testHome, 'missing-interpreter'),
+        wait_ready: waitReady
+      });
+      var run = startApp(env);
+      var response = await run.result;
+      var closed = await run.state.closePromise;
+      await nextTurn();
+
+      assert(response.err instanceof Error);
+      assert.strictEqual(response.err.code, 'ENOENT');
+      assert.strictEqual(response.proc, undefined);
+      assert.strictEqual(run.state.callbackCount, 1);
+      assert.strictEqual(run.state.spawnErrorCount, 1);
+      assert.strictEqual(run.state.exitCount, 0, 'spawn failure has no exit event');
+      assert.strictEqual(run.state.closeCount, 1);
+      assert.strictEqual(closed.code, -2);
+      assert.strictEqual(run.state.killCount, 0, 'do not kill a child that never spawned');
+      assert.deepStrictEqual(run.state.events.filter(function(event) { return event === 'online'; }), []);
+      assert.strictEqual(run.state.child.pid, undefined);
+      assert.strictEqual(fs.existsSync(run.state.child.pm2_env.pm_pid_path), false);
+      assert.strictEqual(God.clusters_db[run.state.child.pm2_env.pm_id], undefined);
+      assertLogsClosed(run.state);
+    });
+
+    it('reports nonexistent cwd spawn failure once (wait_ready=' + waitReady + ')', async function() {
