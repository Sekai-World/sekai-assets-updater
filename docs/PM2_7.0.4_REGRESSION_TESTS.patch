+    assert.strictEqual(fs.readFileSync(response.proc.pm2_env.pm_pid_path, 'utf8'), String(run.state.child.pid));
+    assert.strictEqual(process.kill(run.state.child.pid, 0), true);
+
+    run.state.child.kill('SIGTERM');
+    await run.state.closePromise;
+    await nextTurn();
