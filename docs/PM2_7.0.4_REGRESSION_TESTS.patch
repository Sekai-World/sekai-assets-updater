+
+  it('reports a successful long-running fork online only after spawn and preserves its live PID', async function() {
+    writeFixture('setInterval(function() {}, 1000);');
+    var run = startApp(makeEnv());
+    var response = await run.result;
+
+    assert.ifError(response.err);
