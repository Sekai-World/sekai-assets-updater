+
+function statusOf(entry) {
+  return entry.pm2_env && entry.pm2_env.status || entry.status;
+}
+
+function pidOf(entry) {
+  return Number(entry.pid || (entry.pm2_env && entry.pm2_env.pid)) || 0;
+}
+
+function snapshot(entries) {
+  return entries.map(function(entry) {
+    return { name: nameOf(entry), status: statusOf(entry), pid: pidOf(entry) };
+  }).sort(function(a, b) { return a.name.localeCompare(b.name); });
+}
+
+function processIsAlive(pid) {
+  if (!(pid > 0)) return false;
+  try {
+    process.kill(pid, 0);
+    try {
+      var stat = fs.readFileSync('/proc/' + pid + '/stat', 'utf8');
+      var stateStart = stat.lastIndexOf(')') + 2;
+      var state = stat.slice(stateStart, stateStart + 1);
+      if (state === 'Z' || state === 'X') return false;
+    } catch (e) {
+      if (e.code === 'ENOENT') return false;
+    }
+    return true;
+  } catch (e) {
+    return e.code === 'EPERM';
+  }
+}
+
+function counterOf(spec) {
+  if (!fs.existsSync(spec.counterPath)) return 0;
+  return parseInt(fs.readFileSync(spec.counterPath, 'utf8'), 10) || 0;
+}
+
+function readHeartbeat(spec) {
+  if (!fs.existsSync(spec.heartbeatPath)) return null;
+  try {
+    return JSON.parse(fs.readFileSync(spec.heartbeatPath, 'utf8'));
+  } catch (e) {
+    return null;
+  }
+}
+
+async function waitForFixtureEvidence(spec, expectedPid, expectedCount, timeout) {
+  var deadline = Date.now() + timeout;
+  while (Date.now() < deadline) {
+    var heartbeat = readHeartbeat(spec);
+    if (counterOf(spec) === expectedCount && heartbeat &&
+        heartbeat.pid === expectedPid && Date.now() - heartbeat.at <= 3000) {
+      return heartbeat;
+    }
+    await delay(25);
+  }
+  throw new Error(spec.name + ' did not publish expected start-counter and heartbeat evidence');
+}
+
+function waitForEntry(pm2, name, predicate, timeout, description) {
+  var deadline = Date.now() + timeout;
+  async function poll() {
+    var entries = await entriesFor(pm2, name);
+    var entry = entries[0];
+    if (entry && predicate(entry)) return entry;
+    if (Date.now() >= deadline) {
+      throw new Error('Timed out waiting for ' + description + ': ' + JSON.stringify(snapshot(entries)));
+    }
+    await delay(50);
+    return poll();
+  }
+  return poll();
+}
+
+async function waitForStableUpdateState(pm2, timeout) {
+  var deadline = Date.now() + timeout;
+  var latest = [];
+  while (Date.now() < deadline) {
+    latest = await allEntries(pm2);
+    if (latest.length === specifications.length && latest.every(function(entry) {
+      return statusOf(entry) === 'online' || statusOf(entry) === 'stopped';
+    })) {
+      return latest;
+    }
+    await delay(100);
+  }
+  throw new Error('PM2 process list did not settle after update: ' + JSON.stringify(snapshot(latest)));
+}
+
+function runLocalCli(args, timeout) {
+  return childProcess.spawnSync(process.execPath, [cliPath].concat(args), {
+    cwd: projectRoot,
+    env: process.env,
+    encoding: 'utf8',
+    timeout: timeout || 30000,
+    maxBuffer: 2 * 1024 * 1024
+  });
+}
+
+function expectedStatus(spec) {
+  return spec.kind === 'resident' ? 'online' : 'stopped';
+}
+
+function recoveryProblems(updateResult, entries, counters, before, options) {
+  options = options || {};
+  var problems = [];
+  var updateExitCode = updateResult && updateResult.exitCode !== undefined
+    ? updateResult.exitCode
+    : updateResult && updateResult.status;
+  if (updateExitCode !== 0)
+    problems.push('real pm2 update exit status was not zero');
+
+  var byName = Object.create(null);
+  entries.forEach(function(entry) {
+    var name = nameOf(entry);
+    if (byName[name]) problems.push(name + ' appeared more than once');
+    byName[name] = entry;
+  });
+
+  var expectedNames = specifications.map(function(spec) { return spec.name; }).sort();
+  var actualNames = Object.keys(byName).sort();
+  if (JSON.stringify(actualNames) !== JSON.stringify(expectedNames))
+    problems.push('process name set differs from the seven fixture processes');
+
+  var beforeByName = Object.create(null);
+  before.forEach(function(entry) { beforeByName[entry.name] = entry; });
+
+  var onlineNames = [];
+  specifications.forEach(function(spec) {
+    var entry = byName[spec.name];
+    if (!entry) {
+      problems.push(spec.name + ' is missing from PM2 list');
+      return;
+    }
+
+    var status = statusOf(entry);
+    var pid = pidOf(entry);
+    var expected = expectedStatus(spec);
+    if (status !== expected)
+      problems.push(spec.name + ' status=' + status + ' expected=' + expected);
+    if (status === 'online') onlineNames.push(spec.name);
+
+    var env = entry.pm2_env || entry;
+    if (env.autorestart !== spec.autorestart)
+      problems.push(spec.name + ' autorestart configuration changed');
+
+    if (spec.kind === 'resident') {
+      if (!(pid > 0)) problems.push(spec.name + ' has no live PID');
+      if (options.checkLive !== false && pid > 0 && !processIsAlive(pid))
+        problems.push(spec.name + ' PID is not live');
+      if (beforeByName[spec.name] && pid === beforeByName[spec.name].pid)
+        problems.push(spec.name + ' PID did not change across daemon update');
+      if (counters[spec.name] !== 2)
+        problems.push(spec.name + ' startup counter=' + counters[spec.name] + ' expected=2');
+      var heartbeat = readHeartbeat(spec);
+      if (!heartbeat || heartbeat.pid !== pid || Date.now() - heartbeat.at > 3000)
+        problems.push(spec.name + ' heartbeat does not prove the listed PID is healthy');
+    } else {
+      if (pid !== 0) problems.push(spec.name + ' stopped process retained PID=' + pid);
+      if (counters[spec.name] !== 1)
+        problems.push(spec.name + ' startup counter=' + counters[spec.name] + ' expected=1');
+    }
+  });
+
+  var expectedOnline = specifications.filter(function(spec) {
+    return spec.kind === 'resident';
+  }).map(function(spec) { return spec.name; }).sort();
+  onlineNames.sort();
+  if (JSON.stringify(onlineNames) !== JSON.stringify(expectedOnline))
+    problems.push('online process set differs from the original resident services');
+
+  return problems;
+}
+
+function baselineProblems(entries) {
+  var problems = [];
+  var byName = Object.create(null);
+  entries.forEach(function(entry) { byName[nameOf(entry)] = entry; });
+  if (entries.length !== specifications.length)
+    problems.push('rollback process count differs from seven');
+  specifications.forEach(function(spec) {
+    var entry = byName[spec.name];
+    if (!entry) {
+      problems.push(spec.name + ' missing after rollback');
+      return;
+    }
+    var expected = expectedStatus(spec);
+    var status = statusOf(entry);
+    var pid = pidOf(entry);
+    if (status !== expected)
+      problems.push(spec.name + ' rollback status=' + status + ' expected=' + expected);
+    if (spec.kind === 'resident') {
+      if (!(pid > 0) || !processIsAlive(pid))
+        problems.push(spec.name + ' rollback has no live process');
+      var heartbeat = readHeartbeat(spec);
+      if (!heartbeat || heartbeat.pid !== pid || Date.now() - heartbeat.at > 3000)
+        problems.push(spec.name + ' rollback heartbeat is not fresh for its live PID');
+    } else if (pid !== 0) {
+      problems.push(spec.name + ' rollback stopped process retained a PID');
+    }
+  });
+  return problems;
+}
+
+function countersByName() {
+  var counters = Object.create(null);
+  specifications.forEach(function(spec) { counters[spec.name] = counterOf(spec); });
+  return counters;
+}
+
+async function connectClient() {
+  var pm2 = new PM2.custom({ pm2_home: home });
+  await call(pm2, 'connect');
+  assert.strictEqual(path.resolve(pm2.pm2_home), home);
+  assert.strictEqual(pm2.Client.rpc_socket_file, cst.DAEMON_RPC_PORT);
+  assert.strictEqual(pm2.Client.pub_socket_file, cst.DAEMON_PUB_PORT);
+  return pm2;
+}
+
+async function rollbackFromBaseline() {
+  assert.strictEqual(rollbackAttempted, false, 'run baseline recovery rollback at most once');
+  rollbackAttempted = true;
+  var countersBeforeRollback = countersByName();
+
+  if (rollbackPm2) {
+    try { await call(rollbackPm2, 'disconnect'); } catch (e) {}
+    rollbackPm2 = null;
+  }
+
+  assert(baselineDump, 'rollback requires a pre-update dump snapshot');
+  fs.writeFileSync(cst.DUMP_FILE_PATH, baselineDump, { mode: 0o600 });
+  var killResult = runLocalCli(['kill'], 20000);
+  if (killResult.error) throw new Error('isolated pm2 kill failed during rollback: ' + killResult.error.code);
+  if (killResult.status !== 0)
+    throw new Error('isolated pm2 kill returned nonzero during rollback: ' + killResult.status);
+
+  // `pm2 kill` leaves the dump alone; rewrite the exact pre-update snapshot in
+  // case the update path modified it before failing.
+  fs.writeFileSync(cst.DUMP_FILE_PATH, baselineDump, { mode: 0o600 });
+  var resurrectResult = runLocalCli(['resurrect'], 30000);
+  if (resurrectResult.error)
+    throw new Error('isolated pm2 resurrect failed during rollback: ' + resurrectResult.error.code);
+  if (resurrectResult.status !== 0)
+    throw new Error('isolated pm2 resurrect returned nonzero during rollback: ' + resurrectResult.status);
+
+  rollbackPm2 = await connectClient();
+  var restored = await waitForStableUpdateState(rollbackPm2, 10000);
+  for (var i = 0; i < specifications.length; i++) {
+    var spec = specifications[i];
+    if (spec.kind === 'resident') {
+      var entry = restored.filter(function(candidate) { return nameOf(candidate) === spec.name; })[0];
+      if (entry && pidOf(entry) > 0)
+        await waitForFixtureEvidence(spec, pidOf(entry), countersBeforeRollback[spec.name] + 1, 5000);
+    }
+  }
+  var problems = baselineProblems(restored);
+  if (problems.length)
+    throw new Error('isolated rollback did not restore baseline: ' + JSON.stringify(problems));
+  var countersAfterRollback = countersByName();
+  specifications.forEach(function(spec) {
+    var expected = spec.kind === 'resident'
+      ? countersBeforeRollback[spec.name] + 1
+      : countersBeforeRollback[spec.name];
+    if (countersAfterRollback[spec.name] !== expected)
+      throw new Error(spec.name + ' rollback launch counter=' + countersAfterRollback[spec.name] +
+        ' expected=' + expected);
+  });
+  return {
+    statuses: snapshot(restored),
+    counters: countersAfterRollback,
+    killExitCode: killResult.status,
+    resurrectExitCode: resurrectResult.status
+  };
+}
+
+async function main() {
+  assert.strictEqual(fs.readFileSync(process.env.PM2_MODULE_CONF_FILE, 'utf8'), '{}');
+  assert.strictEqual(fs.existsSync(cliPath), true);
+
+  await call(updatePm2, 'connect');
+  var initialList = await allEntries(updatePm2);
+  assert.deepStrictEqual(snapshot(initialList), [], 'isolated daemon must start empty');
+
+  for (var i = 0; i < specifications.length; i++) {
+    var spec = specifications[i];
+    var startResult = await call(updatePm2, 'start', {
+      script: spec.scriptPath,
+      name: spec.name,
+      cwd: home,
+      exec_mode: 'fork_mode',
+      interpreter: process.execPath,
+      autorestart: spec.autorestart,
+      instances: 1,
+      watch: false,
+      env: {
+        PM2_UPDATE_RECOVERY_FIXTURE: spec.name,
+        PM2_UPDATE_RECOVERY_KIND: spec.kind,
+        PM2_UPDATE_RECOVERY_MARKER: 'synthetic-only'
+      }
+    });
+    assert(!startResult.err || startResult.err === true,
+      spec.name + ' synthetic process start should be accepted');
+    var initiallyOnline = await waitForEntry(updatePm2, spec.name, function(entry) {
+      return statusOf(entry) === 'online' && pidOf(entry) > 0;
+    }, 8000, spec.name + ' initial online state');
+    await waitForFixtureEvidence(spec, pidOf(initiallyOnline), 1, 5000);
+    assert.strictEqual(counterOf(spec), 1, spec.name + ' must have one initial launch');
+    if (spec.kind === 'updater') {
+      var stopResult = await call(updatePm2, 'stop', spec.name);
+      assert(!stopResult.err || stopResult.err === true,
+        spec.name + ' synthetic stop should succeed');
+      await waitForEntry(updatePm2, spec.name, function(entry) {
+        return statusOf(entry) === 'stopped' && pidOf(entry) === 0;
+      }, 8000, spec.name + ' stopped state before update');
+      assert.strictEqual(counterOf(spec), 1,
+        spec.name + ' stop must not trigger another updater launch');
+    }
+  }
+
+  var beforeEntries = await allEntries(updatePm2);
+  var before = snapshot(beforeEntries);
+  var beforeNames = specifications.map(function(spec) { return spec.name; }).sort();
+  assert.deepStrictEqual(before.map(function(entry) { return entry.name; }).sort(), beforeNames);
+  specifications.forEach(function(spec) {
+    var entry = before.filter(function(item) { return item.name === spec.name; })[0];
+    assert(entry, spec.name + ' must be present in recovery baseline');
+    assert.strictEqual(entry.status, expectedStatus(spec));
+    if (spec.kind === 'resident') {
+      assert(entry.pid > 0 && processIsAlive(entry.pid), spec.name + ' baseline PID must be live');
+      var heartbeat = readHeartbeat(spec);
+      assert(heartbeat && heartbeat.pid === entry.pid, spec.name + ' baseline heartbeat must match PID');
+    } else {
+      assert.strictEqual(entry.pid, 0, spec.name + ' baseline stopped PID must be zero');
+      assert.strictEqual(spec.autorestart, false);
+    }
+  });
+  var beforeCounters = countersByName();
+  specifications.forEach(function(spec) {
+    assert.strictEqual(beforeCounters[spec.name], 1,
+      spec.name + ' independent start counter must be exactly one before update');
+  });
+
+  var dumpResult = await call(updatePm2, 'dump');
+  assert(!dumpResult.err || dumpResult.err === true, 'baseline PM2 dump should succeed');
+  assert(fs.existsSync(cst.DUMP_FILE_PATH), 'pre-update dump must exist inside isolated PM2_HOME');
+  baselineDump = fs.readFileSync(cst.DUMP_FILE_PATH);
+  fs.writeFileSync(path.join(home, 'regression-baseline.dump.pm2'), baselineDump, { mode: 0o600 });
+  var dumpedApps = JSON.parse(baselineDump.toString('utf8'));
+  assert.strictEqual(dumpedApps.length, specifications.length,
+    'baseline dump must contain all two resident and five stopped test apps');
+  specifications.forEach(function(spec) {
+    var dumpEntry = dumpedApps.filter(function(app) { return app.name === spec.name; })[0];
+    assert(dumpEntry, spec.name + ' must be present in baseline dump');
+    var dumpedEnv = dumpEntry.pm2_env || dumpEntry;
+    assert.strictEqual(dumpedEnv.status, expectedStatus(spec),
+      spec.name + ' dump status must reflect pre-update state');
+    assert.strictEqual(dumpedEnv.autorestart, spec.autorestart);
+  });
+
+  var daemonPidFile = cst.PM2_PID_FILE_PATH;
+  var daemonPidBeforeUpdate = fs.existsSync(daemonPidFile)
+    ? parseInt(fs.readFileSync(daemonPidFile, 'utf8').trim(), 10) || 0
+    : 0;
+  assert(daemonPidBeforeUpdate > 0 && processIsAlive(daemonPidBeforeUpdate),
+    'isolated PM2 daemon must be live before update');
+
+  await call(updatePm2, 'disconnect');
+  var updateResult = runLocalCli(['update'], 45000);
+  var daemonPidAfterUpdate = fs.existsSync(daemonPidFile)
+    ? parseInt(fs.readFileSync(daemonPidFile, 'utf8').trim(), 10) || 0
+    : 0;
+  var updateEvidence = {
+    exitCode: updateResult.status,
+    signal: updateResult.signal || null,
+    spawnErrorCode: updateResult.error && updateResult.error.code || null,
+    daemonPidBefore: daemonPidBeforeUpdate,
+    daemonPidAfter: daemonPidAfterUpdate
+  };
+
+  try {
+    assert.ifError(updateResult.error);
+    assert.strictEqual(updateResult.signal, null, 'real pm2 update must not be signaled');
+    assert.strictEqual(updateResult.status, 0,
+      'real local pm2 update command must return exit code zero');
+    assert(daemonPidAfterUpdate > 0 && daemonPidAfterUpdate !== daemonPidBeforeUpdate,
+      'real update must replace the isolated daemon PID');
+
+    rollbackPm2 = await connectClient();
+    var afterEntries = await waitForStableUpdateState(rollbackPm2, 15000);
+    await delay(500);
+    afterEntries = await allEntries(rollbackPm2);
+    var after = snapshot(afterEntries);
+    var afterCounters = countersByName();
+    var actualProblems = recoveryProblems(updateEvidence, afterEntries, afterCounters, before);
+    assert.deepStrictEqual(actualProblems, [],
+      'real pm2 update must preserve stopped state, restart only original online entries, and pass live health checks');
+
+    // A zero exit code and apparently correct status are insufficient if an
+    // updater was actually launched. Verify that a deliberately false health
+    // record is rejected by the independent counter invariant.
+    var fakeCounterValues = Object.assign({}, afterCounters);
+    fakeCounterValues['fake-updater-1']++;
+    var fakeCounterProblems = recoveryProblems(updateEvidence, afterEntries,
+      fakeCounterValues, before);
+    assert(fakeCounterProblems.some(function(message) {
+      return message.indexOf('fake-updater-1 startup counter=2 expected=1') >= 0;
+    }), 'fake healthy status with an unexpected launch count must be rejected');
+
+    var fakeStatusEntries = afterEntries.map(function(entry) {
+      var copy = JSON.parse(JSON.stringify(entry));
+      if (nameOf(copy) === 'fake-updater-2') {
+        var liveResident = afterEntries.filter(function(candidate) {
+          return nameOf(candidate) === 'fake-webhook-service';
+        })[0];
+        var livePid = pidOf(liveResident);
+        copy.pid = livePid;
+        copy.pm2_env.pid = livePid;
+        copy.pm2_env.status = 'online';
+      }
+      return copy;
+    });
+    var fakeStatusProblems = recoveryProblems(updateEvidence, fakeStatusEntries,
+      afterCounters, before);
+    assert(fakeStatusProblems.some(function(message) {
+      return message.indexOf('fake-updater-2 status=online expected=stopped') >= 0;
+    }), 'fake online status for a stopped updater must be rejected');
+
+    // Treat the deliberately false health records as a failed validation and
+    // restore the real daemon from the pre-update dump. This exercises the
+    // rollback path without changing production code or using non-test apps.
+    var rollbackEvidence = await rollbackFromBaseline();
+    assert.strictEqual(rollbackEvidence.killExitCode, 0);
+    assert.strictEqual(rollbackEvidence.resurrectExitCode, 0);
+    specifications.forEach(function(spec) {
+      var expected = spec.kind === 'resident' ? 3 : 1;
+      assert.strictEqual(rollbackEvidence.counters[spec.name], expected,
+        spec.name + ' rollback must preserve the expected independent launch count');
+    });
+
+    console.log('UPDATE_RECOVERY_OK ' + JSON.stringify({
+      pm2Version: packageInfo.version,
+      updateExitCode: updateEvidence.exitCode,
+      updateSignal: updateEvidence.signal,
+      daemonPidBeforeUpdate: updateEvidence.daemonPidBefore,
+      daemonPidAfterUpdate: updateEvidence.daemonPidAfter,
+      before: before,
+      afterUpdate: after,
+      afterUpdateCounters: afterCounters,
+      fakeHealthRejectedByCounter: fakeCounterProblems.some(function(message) {
+        return message.indexOf('fake-updater-1 startup counter=2 expected=1') >= 0;
+      }),
+      fakeHealthRejectedByStatus: fakeStatusProblems.some(function(message) {
+        return message.indexOf('fake-updater-2 status=online expected=stopped') >= 0;
+      }),
+      rollback: rollbackEvidence
+    }));
+  } catch (e) {
+    var rollbackSummary = null;
+    if (!rollbackAttempted) {
+      try {
+        rollbackSummary = await rollbackFromBaseline();
+      } catch (rollbackError) {
+        rollbackSummary = { error: rollbackError.message };
+      }
+    } else {
+      rollbackSummary = { error: 'baseline rollback was already attempted once' };
+    }
+    e.message += '\nSanitized update evidence=' + JSON.stringify({
+      update: updateEvidence,
+      before: before,
+      counters: countersByName(),
+      rollback: rollbackSummary
+    });
+    throw e;
+  }
+}
+
+main().then(function() {
+  if (rollbackPm2) {
+    return call(rollbackPm2, 'disconnect').then(function() { process.exit(0); });
+  }
+  process.exit(0);
+}, function(err) {
+  console.error(err && err.stack || err);
+  var disconnected = rollbackPm2 ? call(rollbackPm2, 'disconnect').catch(function() {}) : Promise.resolve();
+  disconnected.then(function() { process.exit(1); });
+  setTimeout(function() { process.exit(1); }, 1500);
+});
