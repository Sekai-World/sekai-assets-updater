+function isProcessAlive(pid) {
+  try {
+    process.kill(pid, 0);
+    // In minimal Linux containers PID 1 may not reap an exited detached daemon.
+    // kill(pid, 0) still succeeds for that zombie, so inspect /proc before
+    // deciding cleanup failed.
+    if (process.platform === 'linux') {
+      try {
+        var stat = fs.readFileSync('/proc/' + pid + '/stat', 'utf8');
+        var state = stat.slice(stat.lastIndexOf(')') + 2, stat.lastIndexOf(')') + 3);
+        if (state === 'Z' || state === 'X') return false;
+      } catch (statError) {
+        if (statError.code === 'ENOENT') return false;
+      }
+    }
+    return true;
+  } catch (err) {
+    return err.code === 'EPERM';
+  }
+}
+
+function delay(ms) {
+  return new Promise(function(resolve) { setTimeout(resolve, ms); });
+}
